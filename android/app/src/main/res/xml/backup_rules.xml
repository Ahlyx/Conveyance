<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 backup policy (android:fullBackupContent). Same intent
  as data_extraction_rules.xml: nothing on the phone side is eligible for
  Auto Backup. See that file's comment for the rationale.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
