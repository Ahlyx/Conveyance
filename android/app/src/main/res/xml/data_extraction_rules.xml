<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer policy. Phone-side state is
  device-bound: per the spec ("Storage layout"), recovery is the 24-word
  phrase, never a cloud backup or device-to-device transfer. Both
  channels are disabled explicitly so the posture is declared, not just
  implied by allowBackup=false.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
